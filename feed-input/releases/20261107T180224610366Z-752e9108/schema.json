{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBBCVM live JSON export v1",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/games"
    },
    {
      "$ref": "#/$defs/history"
    },
    {
      "$ref": "#/$defs/reports"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "release_id",
        "exported_at",
        "season",
        "kind",
        "schema_path",
        "freshness",
        "directory_available",
        "invalid_snapshot_count",
        "games",
        "history",
        "reports"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "season": {
          "const": 2027
        },
        "kind": {
          "const": "manifest"
        },
        "schema_path": {
          "type": "string",
          "pattern": "^releases/[A-Za-z0-9-]+/schema\\.json$"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "directory_available": {
          "type": "boolean"
        },
        "invalid_snapshot_count": {
          "type": "integer",
          "minimum": 0
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shard"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shard"
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shard"
          }
        }
      },
      "additionalProperties": false
    },
    "games": {
      "type": "object",
      "required": [
        "schema_version",
        "release_id",
        "exported_at",
        "season",
        "kind",
        "day_et",
        "games"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "season": {
          "const": 2027
        },
        "kind": {
          "const": "games"
        },
        "day_et": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "const": "unscheduled"
            }
          ]
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game"
          }
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": [
        "schema_version",
        "release_id",
        "exported_at",
        "season",
        "kind",
        "day_et",
        "history"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "season": {
          "const": 2027
        },
        "kind": {
          "const": "history"
        },
        "day_et": {
          "type": "string",
          "format": "date"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "reports": {
      "type": "object",
      "required": [
        "schema_version",
        "release_id",
        "exported_at",
        "season",
        "kind",
        "day_et",
        "report"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "season": {
          "const": 2027
        },
        "kind": {
          "const": "reports"
        },
        "day_et": {
          "type": "string",
          "format": "date"
        },
        "report": {
          "$ref": "#/$defs/report"
        }
      },
      "additionalProperties": false
    },
    "shard": {
      "type": "object",
      "required": [
        "day_et",
        "path",
        "count"
      ],
      "properties": {
        "day_et": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "const": "unscheduled"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^releases/[A-Za-z0-9-]+/(games|history|reports)/([0-9]{4}-[0-9]{2}-[0-9]{2}|unscheduled)\\.json$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "latest_source_observed_at",
        "latest_forecast_generated_at",
        "observation_age_seconds",
        "stale_after_seconds",
        "state",
        "poll_health"
      ],
      "properties": {
        "latest_source_observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_forecast_generated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_age_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "unknown",
            "stale",
            "recent_observation"
          ]
        },
        "poll_health": {
          "const": "unknown"
        }
      },
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "required": [
        "game_id",
        "revision",
        "status",
        "home",
        "away",
        "tipoff_at",
        "scheduled_date_et",
        "tipoff_status",
        "neutral_site",
        "schedule_observed_at",
        "latest_forecast",
        "forecast_missing_reason",
        "data_flags",
        "actual"
      ],
      "properties": {
        "game_id": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "$ref": "#/$defs/team"
        },
        "away": {
          "$ref": "#/$defs/team"
        },
        "tipoff_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduled_date_et": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "tipoff_status": {
          "enum": [
            "confirmed",
            "tbd"
          ]
        },
        "neutral_site": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "latest_forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/forecast"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast_missing_reason": {
          "enum": [
            null,
            "inactive_schedule",
            "tipoff_unconfirmed",
            "site_unconfirmed",
            "invalid_snapshot",
            "no_valid_snapshot_for_current_revision",
            "no_snapshot"
          ]
        },
        "data_flags": {
          "type": "array",
          "items": {
            "enum": [
              "tipoff_unconfirmed",
              "site_unconfirmed",
              "unusable_final_score",
              "awaiting_status_update",
              "no_confirmed_t60"
            ]
          },
          "uniqueItems": true
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/actual"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "latest_forecast": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "forecast_missing_reason": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "forecast_missing_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipoff_status": {
                "const": "tbd"
              }
            }
          },
          "then": {
            "properties": {
              "tipoff_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tipoff_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "team": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "forecast": {
      "type": "object",
      "required": [
        "snapshot_id",
        "game_id",
        "revision",
        "kind",
        "confirmed_t60",
        "model_version",
        "generated_at",
        "data_cutoff_at",
        "tipoff_at",
        "scheduled_date_et",
        "projected",
        "win_probability",
        "prediction_interval",
        "home",
        "away",
        "calibration"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "game_id": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "kind": {
          "enum": [
            "primary",
            "preview",
            "late",
            "provisional"
          ]
        },
        "confirmed_t60": {
          "type": "boolean"
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "data_cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "tipoff_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduled_date_et": {
          "type": "string",
          "format": "date"
        },
        "projected": {
          "type": "object",
          "required": [
            "home",
            "away",
            "margin",
            "total",
            "home_spread"
          ],
          "properties": {
            "home": {
              "type": "number"
            },
            "away": {
              "type": "number"
            },
            "margin": {
              "type": "number"
            },
            "total": {
              "type": "number"
            },
            "home_spread": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "win_probability": {
          "type": "object",
          "required": [
            "home",
            "away"
          ],
          "properties": {
            "home": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "away": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "prediction_interval": {
          "type": "object",
          "required": [
            "level",
            "bounds"
          ],
          "properties": {
            "level": {
              "const": 0.8
            },
            "bounds": {
              "type": "object",
              "required": [
                "home",
                "away",
                "margin",
                "total",
                "home_spread"
              ],
              "properties": {
                "home": {
                  "$ref": "#/$defs/bounds"
                },
                "away": {
                  "$ref": "#/$defs/bounds"
                },
                "margin": {
                  "$ref": "#/$defs/bounds"
                },
                "total": {
                  "$ref": "#/$defs/bounds"
                },
                "home_spread": {
                  "$ref": "#/$defs/bounds"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "home": {
          "$ref": "#/$defs/team"
        },
        "away": {
          "$ref": "#/$defs/team"
        },
        "calibration": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "primary"
              }
            }
          },
          "then": {
            "properties": {
              "confirmed_t60": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "confirmed_t60": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provisional"
              }
            }
          },
          "then": {
            "properties": {
              "tipoff_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tipoff_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "bounds": {
      "type": "object",
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "actual": {
      "type": "object",
      "required": [
        "home",
        "away",
        "margin",
        "total"
      ],
      "properties": {
        "home": {
          "type": "number",
          "minimum": 0
        },
        "away": {
          "type": "number",
          "minimum": 0
        },
        "margin": {
          "type": "number"
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "grade": {
      "type": "object",
      "required": [
        "correct_winner",
        "brier",
        "absolute_error",
        "covered_80"
      ],
      "properties": {
        "correct_winner": {
          "type": "boolean"
        },
        "brier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "absolute_error": {
          "type": "object",
          "required": [
            "home",
            "away",
            "margin",
            "total"
          ],
          "properties": {
            "home": {
              "type": "number",
              "minimum": 0
            },
            "away": {
              "type": "number",
              "minimum": 0
            },
            "margin": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "covered_80": {
          "type": "object",
          "required": [
            "home",
            "away",
            "margin",
            "total"
          ],
          "properties": {
            "home": {
              "type": "boolean"
            },
            "away": {
              "type": "boolean"
            },
            "margin": {
              "type": "boolean"
            },
            "total": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "historyEntry": {
      "type": "object",
      "required": [
        "forecast",
        "result_status",
        "actual",
        "grade"
      ],
      "properties": {
        "forecast": {
          "$ref": "#/$defs/forecast"
        },
        "result_status": {
          "enum": [
            "graded",
            "final_ungraded",
            "awaiting_final",
            "unusable_final",
            "superseded",
            "schedule_unavailable"
          ]
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/actual"
            },
            {
              "type": "null"
            }
          ]
        },
        "grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/grade"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result_status": {
                "const": "graded"
              }
            }
          },
          "then": {
            "properties": {
              "grade": {
                "$ref": "#/$defs/grade"
              },
              "actual": {
                "$ref": "#/$defs/actual"
              }
            }
          },
          "else": {
            "properties": {
              "grade": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "required": [
        "report_date_et",
        "report_generated_at",
        "daily",
        "cumulative",
        "ungraded_final_game_ids",
        "games"
      ],
      "properties": {
        "report_date_et": {
          "type": "string",
          "format": "date"
        },
        "report_generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "daily": {
          "$ref": "#/$defs/metrics"
        },
        "cumulative": {
          "$ref": "#/$defs/metrics"
        },
        "ungraded_final_game_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "games": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "game_id",
              "snapshot_id",
              "actual",
              "grade"
            ],
            "properties": {
              "game_id": {
                "type": "integer",
                "minimum": 1
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "actual": {
                "$ref": "#/$defs/actual"
              },
              "grade": {
                "$ref": "#/$defs/grade"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "graded_games",
        "winner_accuracy",
        "team_score_mae",
        "spread_mae",
        "total_mae",
        "brier",
        "score_coverage_80",
        "spread_coverage_80",
        "total_coverage_80"
      ],
      "properties": {
        "graded_games": {
          "type": "integer",
          "minimum": 0
        },
        "winner_accuracy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "team_score_mae": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "spread_mae": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_mae": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "brier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "score_coverage_80": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "spread_coverage_80": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "total_coverage_80": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
